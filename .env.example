# Base de datos: PostgreSQL en Supabase. Usar la cadena del "Session pooler" (puerto 5432),
# con la contraseña ya incluida (si tiene @ : / # ? % conviene elegir una solo alfanumérica).
SUPABASE_DB_URL=postgresql://postgres.<codigo-del-proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Solo para pruebas de integración y E2E: crean un esquema temporal rpg_test_* / rpg_e2e_* y lo borran
# al terminar; nunca tocan el esquema public. Puede ser la misma URL que SUPABASE_DB_URL.
TEST_DB_URL=
# Puerto donde escucha la API (npm run dev)
PORT=3000
# Origen exacto del frontend; en producción es la URL pública de la app (https://...).
CORS_ORIGIN=http://localhost:5173
# No mostrar consultas con datos privados salvo diagnóstico local explícito.
DB_DEBUG=false
# En producción: NODE_ENV=production (cookie Secure y trust proxy).
# NODE_ENV=production
